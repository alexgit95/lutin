@startuml
hide circle
skinparam linetype ortho

entity "utilisateur" as utilisateur {
  * id : bigint <<PK>>
  --
  * login : varchar(50) <<unique>>
  * password_hash : varchar
  admin_marker : boolean <<unique, non nul = admin>>
}

entity "liste_achat" as liste_achat {
  * id : bigint <<PK>>
  --
  * nom : varchar(100)
  * proprietaire_id : bigint <<FK>>
}

entity "personne" as personne {
  * id : bigint <<PK>>
  --
  * nom : varchar(100)
  * budget : numeric(12,2)
  * liste_id : bigint <<FK>>
}

entity "cadeau" as cadeau {
  * id : bigint <<PK>>
  --
  * nom : varchar
  url : varchar(2048)
  prix : numeric(12,2)
  * statut : varchar(20)
  * masque : boolean
  * pour_tiers : boolean
  * personne_id : bigint <<FK>>
  * liste_id : bigint <<FK>>
}

entity "tag" as tag {
  * id : bigint <<PK>>
  --
  * nom : varchar(50)
  * liste_id : bigint <<FK>>
  <<unique (nom, liste_id)>>
}

entity "cadeau_tag" as cadeau_tag {
  * cadeau_id : bigint <<FK>>
  * tag_id : bigint <<FK>>
}

entity "partage" as partage {
  * id : bigint <<PK>>
  --
  * liste_id : bigint <<FK>>
  * lecteur_id : bigint <<FK>>
  <<unique (liste_id, lecteur_id)>>
}

entity "wishlist" as wishlist {
  * id : bigint <<PK>>
  --
  * nom : varchar(100)
  * nom_cle : varchar(100) <<nom nettoyé en minuscules>>
  jeton_public : varchar(64) <<unique, nul = privée, secret du lien /p/{jeton}>>
  * proprietaire_id : bigint <<FK>>
  <<unique (proprietaire_id, nom_cle)>>
}

entity "souhait" as souhait {
  * id : bigint <<PK>>
  --
  * nom : varchar
  url : varchar(2048)
  prix : numeric(12,2)
  pris_par_nom : varchar(100) <<texte, sans FK : login ou nom d'invité>>
  pris_par_invite : boolean <<nul = faux ; vrai pour un nom saisi via le lien public>>
  pris_le : timestamp
  * wishlist_id : bigint <<FK>>
}

entity "wishlist_partage" as wishlist_partage {
  * id : bigint <<PK>>
  --
  * wishlist_id : bigint <<FK>>
  * lecteur_id : bigint <<FK>>
  <<unique (wishlist_id, lecteur_id)>>
}

entity "avis" as avis {
  * id : bigint <<PK>>
  --
  * destinataire_id : bigint <<FK>>
  * type : varchar(30) <<MODIFIE, SUPPRIME, WISHLIST_SUPPRIMEE>>
  souhait_id : bigint <<sans FK>>
  wishlist_id : bigint <<sans FK>>
  * wishlist_nom : varchar(100)
  article_nom : varchar
  pris_par_nom : varchar(100)
  nombre : integer
  * cree_le : timestamp <<expire après 90 jours>>
  <<index (destinataire_id)>>
}

utilisateur ||--o{ liste_achat : possède
liste_achat ||--o{ personne
liste_achat ||--o{ cadeau
liste_achat ||--o{ tag
liste_achat ||--o{ partage
utilisateur ||--o{ partage : lecteur
personne ||--o{ cadeau : destinataire
cadeau ||--o{ cadeau_tag
tag ||--o{ cadeau_tag
utilisateur ||--o{ wishlist : possède
wishlist ||--o{ souhait
wishlist ||--o{ wishlist_partage
utilisateur ||--o{ wishlist_partage : lecteur
utilisateur ||--o{ avis : destinataire
@enduml
